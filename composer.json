{
  "name": "dnadesign/silverstripe-campaign-schedule",
  "description": "SilverStripe campaign scheduling interface",
  "license": "BSD-3-Clause",
  "type": "silverstripe-vendormodule",
  "authors": [
    {
      "name": "Alexandre Saelens",
      "email": "alexandre.saelens@dna.co.nz"
    }
  ],
  "require": {
    "php": "^8.3",
    "silverstripe/campaign-admin": "^2.0",
    "silverstripe/crontask": "^3.0",
    "silverstripe/framework": "^5.0",
    "silverstripe/versioned": "^2.0"
  },
  "require-dev": {
    "cambis/silverstripe-rector": "^0.7",
    "ergebnis/composer-normalize": "^2.41",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^1.12",
    "phpstan/phpstan-deprecation-rules": "^1.2",
    "rector/rector": "^1.2",
    "silverstripe/standards": "^1.2",
    "symplify/easy-coding-standard": "^12.3"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "DNADesign\\CampaignSchedule\\": "src"
    }
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "ergebnis/composer-normalize": true,
      "silverstripe/vendor-plugin": true,
      "phpstan/extension-installer": true
    },
    "sort-packages": true
  }
}
