{
  "name": "dnadesign/silverstripe-campaign-schedule",
  "description": "SilverStripe campaign scheduling interface",
  "type": "silverstripe-vendormodule",
  "license": "BSD-3-Clause",
  "authors": [{
      "name": "Alexandre Saelens",
      "email": "alexandre.saelens@dna.co.nz"
  }],
  "require": {
    "php": "^8.3",
    "silverstripe/campaign-admin": "^2.0",
    "silverstripe/crontask": "^3.0",
    "silverstripe/framework": "^5.0"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "silverstripe/vendor-plugin": true
    },
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "DNADesign\\CampaignSchedule\\": "src"
    }
  }
}
